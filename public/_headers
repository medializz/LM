# =============================================================================
# LIZZDO MEDIA PRODUCTION SECURITY & CACHING HEADERS
# Target: Cloudflare Pages / Edge Proxy
# =============================================================================

/*
  # Enforce HTTPS and instruct modern browsers never to connect over HTTP
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  # Prevent MIME type sniffing
  X-Content-Type-Options: nosniff
  # Frame protection (allows Decap CMS preview inside same origin)
  X-Frame-Options: SAMEORIGIN
  # Referrer policy for privacy and security
  Referrer-Policy: strict-origin-when-cross-origin
  # Restrict unauthorized hardware permissions
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# Immutable caching for hashed assets
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Cache SVG uploads and logos for 1 week with stale-while-revalidate
/uploads/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
